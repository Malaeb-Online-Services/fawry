{
    "name": "malaeb/fawry",
    "description": "A Laravel package for Fawry payment gateway integration",
    "type": "library",
    "license": "MIT",
    "version": "1.0.1",
    "autoload": {
        "psr-4": {
            "Malaeb\\Fawry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Malaeb\\Fawry\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Malaeb",
            "email": "ayman@malaebapp.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "illuminate/support": "Required for Laravel integration"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Malaeb\\Fawry\\FawryServiceProvider"
            ],
            "aliases": {
                "Fawry": "Malaeb\\Fawry\\Facades\\Fawry"
            }
        }
    }
} 