{
    "name": "aymanzayedelshehawy/fawry",
    "description": "A Laravel package for Fawry payment gateway integration",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "autoload": {
        "psr-4": {
            "AymanZayedElshehawy\\Fawry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AymanZayedElshehawy\\Fawry\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^9.0|^10.0",
        "illuminate/support": "^9.0|^10.0",
        "illuminate/contracts": "^9.0|^10.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AymanZayedElshehawy\\Fawry\\FawryServiceProvider"
            ],
            "aliases": {
                "Fawry": "AymanZayedElshehawy\\Fawry\\Facades\\Fawry"
            }
        }
    }
} 